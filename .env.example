# ============================================
# Kabe — Environment Variables
# Domain: kabe.lrznd.my.id
# ============================================
# Copy this file to .env and fill in your values.
# JANGAN commit .env ke repository!

# --- Database ---
DB_USER=kb_user
DB_PASSWORD=change_this_db_password
DB_NAME=kb_database

# --- Directus CMS ---
# Generate random strings: openssl rand -hex 32
DIRECTUS_KEY=change_me_to_random_64_char_string
DIRECTUS_SECRET=change_me_to_random_64_char_string
DIRECTUS_ADMIN_EMAIL=admin@internal.kb
DIRECTUS_ADMIN_PASSWORD=change_this_admin_password
# Public URL where Directus is accessed via reverse proxy
DIRECTUS_PUBLIC_URL=https://kabe.lrznd.my.id/cms

# --- Meilisearch ---
MEILI_MASTER_KEY=change_me_to_random_meili_key

# --- Site ---
SITE_URL=https://kabe.lrznd.my.id

# --- Reverse Proxy ---
# Nginx dijalankan terpisah (di luar Docker).
# Konfigurasi Nginx: docker/nginx/kabe.lrznd.my.id.conf
