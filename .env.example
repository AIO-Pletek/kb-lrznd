# ============================================
# Kabe — Environment Variables
# Domain: kabe.lrznd.my.id
# ============================================
# Copy this file to .env and fill in your values.
# JANGAN commit .env ke repository!

# --- Database ---
DB_USER=kb_user
DB_PASSWORD=change_this_db_password
DB_NAME=kb_database
# DATABASE_URL auto-generated di Docker, ini buat dev lokal
DATABASE_URL=postgresql://kb_user:change_this_db_password@localhost:5432/kb_database

# --- Admin Auth ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
SESSION_SECRET=change_me_to_at_least_32_char_random_string

# --- Site ---
SITE_URL=https://kabe.lrznd.my.id

# --- Reverse Proxy ---
# Nginx dijalankan terpisah (di luar Docker).
# Konfigurasi Nginx: docker/nginx/kabe.lrznd.my.id.conf
